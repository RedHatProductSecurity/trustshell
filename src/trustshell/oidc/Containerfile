FROM registry.redhat.io/ubi10:10.0

LABEL summary="TrustShell OIDC PKCE Server" \
      maintainer="Product Security DevOps <prodsec-dev@redhat.com>"

ARG PYPI_MIRROR="https://pypi.python.org/simple"
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_INDEX_URL=$PYPI_MIRROR \
    LISTEN_PORT=8650

EXPOSE 8650

# Install system dependencies needed for Python packages
RUN dnf update -y && \
    dnf install -y \
        gcc \
        python3-devel \
        krb5-devel \
        libffi-devel \
        openssl-devel && \
    dnf clean all

# Download the UV installer
ADD https://astral.sh/uv/0.7.12/install.sh /uv-installer.sh

# Run the installer then remove it
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Ensure the installed binary is on the `PATH`
ENV PATH="/root/.local/bin/:$PATH"

# Copy the project files (build context should be project root)
WORKDIR /opt/app-root
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/

# Install Python dependencies
RUN uv sync --frozen

# Set working directory to oidc directory and run the server
WORKDIR /opt/app-root/src/trustshell/oidc
CMD ["uv", "run", "python", "oidc_pkce_server.py"]